# Reuse the matching candidate build options for the corrected reference.
get_filename_component(_moe_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
get_filename_component(_moe_build_name "${CMAKE_BINARY_DIR}" NAME)
if (NOT _moe_build_name MATCHES "^build-rocm-moe-corrected-(reference|measure)$")
    message(FATAL_ERROR "Use build-rocm-moe-corrected-reference or build-rocm-moe-corrected-measure")
endif()
set(_moe_phase "${CMAKE_MATCH_1}")
set(_moe_cache_dir "${_moe_root}/build-rocm-moe-stream-${_moe_phase}")
set(_moe_cache "${_moe_cache_dir}/CMakeCache.txt")
if (NOT EXISTS "${_moe_cache}")
    message(FATAL_ERROR "Missing candidate configuration: ${_moe_cache}")
endif()

# Do not copy package discovery, source/output directories or version metadata.
file(STRINGS "${_moe_cache}" _moe_entries)
set(_moe_keys)
foreach(_moe_line IN LISTS _moe_entries)
    if (NOT _moe_line MATCHES "^([A-Za-z_][A-Za-z0-9_]*):(BOOL|STRING|UNINITIALIZED|FILEPATH|PATH)=")
        continue()
    endif()
    set(_moe_name "${CMAKE_MATCH_1}")
    set(_moe_type "${CMAKE_MATCH_2}")
    if (_moe_name MATCHES "^(GGML|LLAMA)_(BUILD_NUMBER|BUILD_COMMIT|BUILD_VERSION|COMMIT|VERSION.*)$")
        continue()
    endif()
    if (_moe_name MATCHES "^(GGML_|LLAMA_)")
        if (NOT _moe_type MATCHES "^(BOOL|STRING|UNINITIALIZED)$")
            continue()
        endif()
    elseif (NOT _moe_name MATCHES "^CMAKE_((C|CXX|HIP)_COMPILER(_LAUNCHER)?|(C|CXX|HIP)_FLAGS(_[A-Z]+)?|HIP_ARCHITECTURES|BUILD_TYPE|(EXE|SHARED|MODULE)_LINKER_FLAGS(_[A-Z]+)?|POSITION_INDEPENDENT_CODE|INTERPROCEDURAL_OPTIMIZATION(_[A-Z]+)?)$" AND NOT _moe_name MATCHES "^(AMDGPU_TARGETS|GPU_TARGETS|BUILD_SHARED_LIBS)$")
        continue()
    endif()
    if (_moe_type STREQUAL "UNINITIALIZED")
        set(_moe_type STRING)
    endif()
    list(APPEND _moe_keys "${_moe_name}")
    set(_moe_type_${_moe_name} "${_moe_type}")
endforeach()

# The cache loader preserves list-valued options such as the HIP architectures.
load_cache("${_moe_cache_dir}" READ_WITH_PREFIX _moe_cached_ ${_moe_keys})
foreach(_moe_name IN LISTS _moe_keys)
    set(_moe_value "${_moe_cached_${_moe_name}}")
    if (_moe_value MATCHES "build-rocm-moe-stream-(reference|measure)")
        message(FATAL_ERROR "Candidate build directory embedded in option ${_moe_name}")
    endif()
    set(${_moe_name} "${_moe_value}" CACHE ${_moe_type_${_moe_name}} "Copied from the candidate configuration" FORCE)
endforeach()

if (NOT _moe_cached_GGML_HIP)
    message(FATAL_ERROR "The candidate configuration must enable GGML_HIP")
endif()
if (_moe_phase STREQUAL "reference" AND _moe_cached_LLAMA_MOE_MEASURE)
    message(FATAL_ERROR "The candidate reference configuration must disable LLAMA_MOE_MEASURE")
endif()
if (_moe_phase STREQUAL "measure" AND NOT _moe_cached_LLAMA_MOE_MEASURE)
    message(FATAL_ERROR "The candidate measurement configuration must enable LLAMA_MOE_MEASURE")
endif()
list(LENGTH _moe_keys _moe_count)
message(STATUS "MoE reference: copied ${_moe_count} options from ${_moe_cache}")
